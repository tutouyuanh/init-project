{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ES2015",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "isolatedModules": true,
    "moduleResolution": "node",
    "noEmit": true,
    "lib": ["ES2017", "DOM"]
  },
  "exclude": ["node_modules", "library", "local", "temp", "build", "preview"]
}
